--!strict
--!native
-- physik: rigid bodies in three dimensions, for Jess.
--
-- A world holds bodies, each a shape with a place and a rotation, and `step` moves them: under
-- gravity and whatever pushes them, apart where they touch, together where they are joined.
-- Around that a world answers questions, of rays and swept shapes and boxes, and hands its
-- state out in columns for whatever draws it or sends it.
--
-- This file is the way in: the shapes, the world, and what a step does in what order. The
-- work is in the modules beside it, one to each part of a step.
local broadphase = require './broadphase'
local drains = require './drains'
local queries = require './queries'
local shapes = require './shape'
local solver = require './solver'
local types = require './types'
local worlds = require './world'

local physik = {}

type State = worlds.State

export type Shape = types.Shape
export type Rotation = types.Rotation
export type WorldOptions = worlds.Options
export type BodyOptions = worlds.BodyOptions
export type JointOptions = worlds.JointOptions
export type Body = worlds.Body
export type CastHit = queries.CastHit
export type RayHit = queries.RayHit
export type Overlaps = queries.Overlaps
export type Contact = drains.Contact
export type Stats = drains.Stats

--- Moves the world on by `duration`, in `substeps` equal parts if more than one is asked for,
--- and returns how many contacts the last part found. Each part moves the bodies, stops the
--- ones that are swept, finds what touches, and solves it.
local function step(state: State, duration: number, substeps: number?): number
  assert(type(duration) == 'number' and duration > 0, 'physik.step: dt must be > 0')

  local parts = substeps or 1
  assert(parts >= 1 and parts % 1 == 0, 'physik.step: substeps must be a positive integer')

  local each = duration / parts

  for _ = 1, parts do
    solver.integrate(state, each)
    queries.sweepBodies(state)
    broadphase.collide(state)

    if state.trackContactEvents then
      solver.buildContactEvents(state)
    else
      state.contactEventCount = 0
    end

    if state.stirring == 0 and state.jointCount == 0 and not state.stillWasMoved then
      -- Everything is at rest, and touches as it did: nothing is woken, joined or solved.
      state.activeContactCount = 0
      state.warmStartedCount = 0
    elseif state.contactCount == 0 and state.jointCount == 0 then
      -- Nothing touches and nothing is joined, so every body is an island of its own.
      state.activeContactCount = 0
      state.warmStartedCount = 0
      solver.sleepIndependent(state, each)
      if state.cacheEpoch % 64 == 0 then solver.forgetStaleContacts(state) end
    else
      solver.wakeContacts(state)
      solver.buildIslands(state)
      solver.prepareContacts(state, each)
      solver.solveContacts(state, each)
      solver.storeContactCache(state)
      solver.correctPositions(state)
      solver.sleep(state, each)
    end

    -- Solving moves bodies after the grid was built, so a question asked next has it looked
    -- over again. Nothing has moved when nothing stirred.
    if state.stirring > 0 then state.gridValid = false end
  end

  state.frame += 1

  return state.contactCount
end

--- Moves the world on by time as it passes, in steps of a fixed length: `elapsed` is added to
--- what was left over, and as many whole steps are taken as fit, up to `maxSteps`. Returns how
--- many steps were taken, how far into the next one the world is, as a fraction, for whatever
--- draws between steps, and whether time was dropped because too much of it had built up.
local function advance(state: State, elapsed: number, fixedStep: number?, maxSteps: number?): (number, number, boolean)
  assert(type(elapsed) == 'number' and elapsed >= 0, 'physik.advance: dt must be >= 0')

  local each = fixedStep or state.fixedDt
  local limit = maxSteps or state.maxCatchUpSteps
  assert(each > 0 and limit >= 1 and limit % 1 == 0, 'physik.advance: fixedDt must be > 0 and maxSteps a positive integer')

  state.accumulator += elapsed

  local steps = math.min(math.floor(state.accumulator / each), limit)

  for _ = 1, steps do
    step(state, each)
  end

  state.accumulator -= steps * each

  local dropped = state.accumulator >= each
  if dropped then state.accumulator %= each end

  return steps, state.accumulator / each, dropped
end

--- Moves the origin by `delta`, and returns the world.
local function shiftOrigin(state: State, delta: vector): State
  worlds.shiftOrigin(state, delta)

  return state
end

local Methods = {
  step = step,
  advance = advance,

  addBody = worlds.addBody,
  removeBody = worlds.removeBody,
  hasBody = worlds.hasBody,
  getBody = worlds.getBody,
  setPosition = worlds.setPosition,
  setRotation = worlds.setRotation,
  setVelocity = worlds.setVelocity,
  setAngularVelocity = worlds.setAngularVelocity,
  driveKinematic = worlds.driveKinematic,
  shiftOrigin = shiftOrigin,
  wake = worlds.wake,
  applyForce = worlds.applyForce,
  applyForceAtPoint = worlds.applyForceAtPoint,
  applyTorque = worlds.applyTorque,
  applyImpulse = solver.applyImpulse,
  applyAngularImpulse = solver.applyAngularImpulse,

  addDistanceJoint = worlds.addDistanceJoint,
  addBallJoint = worlds.addBallJoint,
  addHingeJoint = worlds.addHingeJoint,
  removeJoint = worlds.dropJoint,

  raycast = queries.raycast,
  raycastBatch = queries.raycastBatch,
  raycastBatchSoA = queries.raycastBatchSoA,
  queryAabb = queries.queryAabb,
  sphereCast = queries.sphereCast,
  sphereCastBatchSoA = queries.sphereCastBatchSoA,
  capsuleCast = queries.capsuleCast,
  capsuleContacts = queries.capsuleContacts,

  linearStateView = drains.linearStateView,
  writeLinearState = drains.writeLinearState,
  writeTransforms = drains.writeTransforms,
  applyTransforms = drains.applyTransforms,
  writeContacts = drains.writeContacts,
  writeContactEvents = drains.writeContactEvents,
  contacts = drains.contacts,
  stats = drains.stats,
}

Methods.__index = Methods

local Metatable = table.freeze(Methods)

export type World = typeof(setmetatable({} :: State, Metatable))

--- A world with nothing in it.
function physik.newWorld(options: worlds.Options?): World
  return setmetatable(worlds.new(options), Metatable)
end

physik.sphere = shapes.sphere
physik.box = shapes.box
physik.capsule = shapes.capsule
physik.compound = shapes.compound
physik.triangleMesh = shapes.triangleMesh
physik.heightfield = shapes.heightfield
physik.quat = shapes.quat
physik.axisAngle = shapes.axisAngle

-- What a pair of bodies did in a step, as `writeContactEvents` writes it.
physik.contactEvent = solver.ContactEvent

return table.freeze(physik)
